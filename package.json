{
  "name": "xpde",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "dev:control": "pnpm --filter @xpde/control dev",
    "dev:panel": "pnpm --filter @xpde/panel dev",
    "dev:run": "pnpm --filter @xpde/run dev",
    "lint": "pnpm lint:js && pnpm lint:rust",
    "lint:js": "eslint . --max-warnings 0",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "lint:fix": "eslint . --fix && cargo fmt --all"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.0",
    "globals": "^16.5.0",
    "svelte": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.3"
  }
}

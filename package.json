{
  "name": "xpde",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.12",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "build:apps": "bun run --filter './apps/*' build",
    "dev:control": "bun run --filter '@xpde/control' dev",
    "dev:panel": "bun run --filter '@xpde/panel' dev",
    "dev:run": "bun run --filter '@xpde/run' dev",
    "lint": "bun run lint:js && bun run lint:rust",
    "lint:js": "eslint . --max-warnings 0",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "lint:fix": "eslint . --fix && cargo fmt --all"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.0",
    "globals": "^16.5.0",
    "svelte": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.3"
  }
}
